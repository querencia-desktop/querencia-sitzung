#. TRANSLATORS: Desktop-Datei, Schlüssel Name
#: data/org.querencia.Sitzung.desktop.in:14
msgid "Querencia Sitzung"
msgstr "Querencia Sitzung"

#. TRANSLATORS: Desktop-Datei, Schlüssel GenericName
#: data/org.querencia.Sitzung.desktop.in:15
msgid "Session"
msgstr "Sesión"

#. TRANSLATORS: Desktop-Datei, Schlüssel Comment
#: data/org.querencia.Sitzung.desktop.in:16
msgid "Log out, lock the screen, restart or shut down"
msgstr "Cerrar la sesión, bloquear la pantalla, reiniciar o apagar"

#: src/aktion.rs:64
msgid "Cannot log out: no labwc of this session (LABWC_PID)"
msgstr ""
"No se puede cerrar la sesión: no hay ningún labwc en esta sesión (LABWC_PID)"

#: src/aktion.rs:81
#, no-c-format
msgid "{program} --exit failed: {error}"
msgstr "Falló {program} --exit: {error}"

#: src/aktion.rs:93
#, no-c-format
msgid "{program} --exit reported {status}"
msgstr "{program} --exit devolvió {status}"

#. TRANSLATORS: {action} ist „Restart“ oder „Shut Down“.
#: src/aktion.rs:110
#, no-c-format
msgid ""
"{action} is not allowed for this user (logind: no). Please run it at the console or as an administrator."
msgstr ""
"{action}: operación no permitida para este usuario (logind: no). Ejecútela en la consola o como administrador."

#: src/aktion.rs:115
#, no-c-format
msgid "{action} is not possible on this system (logind: na)."
msgstr "{action}: operación no posible en este sistema (logind: na)."

#: src/aktion.rs:119
#, no-c-format
msgid "{action}: unexpected answer from logind: “{answer}”"
msgstr "{action}: respuesta inesperada de logind: «{answer}»"

#: src/aktion.rs:133
#, no-c-format
msgid "System D-Bus not reachable: {error}"
msgstr "No se puede acceder al D-Bus del sistema: {error}"

#: src/aktion.rs:190
#, no-c-format
msgid "Cannot start the lock screen ({program}): {error}"
msgstr "No se puede iniciar el bloqueo de pantalla ({program}): {error}"

#: src/bin/querencia-polkit-agent.rs:268
msgid "Authenticate"
msgstr "Se necesita autenticación"

#. TRANSLATORS: nur wenn polkitd keine eigene Meldung schickt.
#: src/bin/querencia-polkit-agent.rs:285
msgid "An application requires authentication."
msgstr "Una aplicación necesita autenticación."

#: src/bin/querencia-polkit-agent.rs:296
#, no-c-format
msgid "Action: {action}"
msgstr "Acción: {action}"

#: src/bin/querencia-polkit-agent.rs:303
#, no-c-format
msgid "Password for {user}:"
msgstr "Contraseña de {user}:"

#: src/bin/querencia-polkit-agent.rs:315
msgid "Connecting to the authentication service…"
msgstr "Conectando con el servicio de autenticación…"

#: src/bin/querencia-polkit-agent.rs:327 src/dialog.rs:40
msgid "_Cancel"
msgstr "_Cancelar"

#: src/bin/querencia-polkit-agent.rs:331
msgid "_Authenticate"
msgstr "_Autenticar"

#: src/bin/querencia-polkit-agent.rs:448
msgid "Enter the password and press Enter"
msgstr "Escriba la contraseña y pulse Intro"

#: src/bin/querencia-polkit-agent.rs:525
#, no-c-format
msgid "Wrong password, please try again ({attempt} of {max})"
msgstr "Contraseña incorrecta, inténtelo de nuevo ({attempt} de {max})"

#: src/bin/querencia-polkit-agent.rs:570
msgid "Checking the password…"
msgstr "Comprobando la contraseña…"

#: src/dialog.rs:25
msgid "Log _Out"
msgstr "Cerrar la _sesión"

#: src/dialog.rs:27
msgid "_Lock Screen"
msgstr "_Bloquear la pantalla"

#: src/dialog.rs:30
msgid "_Restart"
msgstr "_Reiniciar"

#: src/dialog.rs:32
msgid "_Shut Down"
msgstr "_Apagar"

#: src/dialog.rs:46
msgid "Log Out"
msgstr "Cerrar la sesión"

#: src/dialog.rs:47
msgid "Lock Screen"
msgstr "Bloquear la pantalla"

#: src/dialog.rs:48
msgid "Restart"
msgstr "Reiniciar"

#: src/dialog.rs:49
msgid "Shut Down"
msgstr "Apagar"

#: src/dialog.rs:56
msgid ""
"All applications will be closed. Anything not saved there will be lost."
msgstr ""
"Se cerrarán todas las aplicaciones. Lo que no se haya guardado se perderá."

#: src/dialog.rs:60
msgid "Log out of this system now?"
msgstr "¿Cerrar la sesión ahora?"

#: src/dialog.rs:61
msgid ""
"All applications of this session will be closed. Anything not saved there will be lost."
msgstr ""
"Se cerrarán todas las aplicaciones de esta sesión. Lo que no se haya guardado se perderá."

#: src/dialog.rs:68
msgid "Lock the screen now?"
msgstr "¿Bloquear la pantalla ahora?"

#: src/dialog.rs:69
msgid ""
"The password is needed to unlock the screen. The applications keep running."
msgstr ""
"Se necesita la contraseña para desbloquear la pantalla. Las aplicaciones siguen en ejecución."

#: src/dialog.rs:76
msgid "Restart this system now?"
msgstr "¿Reiniciar el equipo ahora?"

#: src/dialog.rs:82
msgid "Shut down or restart this system now?"
msgstr "¿Apagar o reiniciar el equipo ahora?"

#: src/dialog.rs:94
#, no-c-format
msgid "You will be automatically logged out in {n} second."
msgid_plural "You will be automatically logged out in {n} seconds."
msgstr[0] "La sesión se cerrará automáticamente en {n} segundo."
msgstr[1] "La sesión se cerrará automáticamente en {n} segundos."

#: src/dialog.rs:100
#, no-c-format
msgid "The screen will be locked automatically in {n} second."
msgid_plural "The screen will be locked automatically in {n} seconds."
msgstr[0] "La pantalla se bloqueará automáticamente en {n} segundo."
msgstr[1] "La pantalla se bloqueará automáticamente en {n} segundos."

#: src/dialog.rs:106
#, no-c-format
msgid "This system will be automatically restarted in {n} second."
msgid_plural "This system will be automatically restarted in {n} seconds."
msgstr[0] "El equipo se reiniciará automáticamente en {n} segundo."
msgstr[1] "El equipo se reiniciará automáticamente en {n} segundos."

#: src/dialog.rs:112
#, no-c-format
msgid "This system will be automatically shut down in {n} second."
msgid_plural "This system will be automatically shut down in {n} seconds."
msgstr[0] "El equipo se apagará automáticamente en {n} segundo."
msgstr[1] "El equipo se apagará automáticamente en {n} segundos."

#. TRANSLATORS: steht unter der Countdown-Zeile, solange ein anderes Fenster aktiv ist.
#: src/dialog.rs:187
msgid "Paused while this window is not active."
msgstr "En pausa mientras esta ventana no esté activa."

#: src/dialog.rs:220
msgid "End Session"
msgstr "Terminar la sesión"

#: src/dialog.rs:221
msgid "End this session now?"
msgstr "¿Terminar esta sesión ahora?"

#: src/dialog.rs:222
msgid ""
"Log Out closes all applications of this session; Restart and Shut Down stop the computer. Anything not saved will be lost."
msgstr ""
"«Cerrar la sesión» cierra todas las aplicaciones de esta sesión; «Reiniciar» y «Apagar» detienen el equipo. Lo que no se haya guardado se perderá."

#: src/dialog.rs:523
msgid "_Close"
msgstr "_Cerrar"

#: src/pam.rs:144 src/sperre.rs:340
msgid "Wrong password"
msgstr "Contraseña incorrecta"

#: src/pam.rs:145
msgid "Too many failed attempts, please wait a moment"
msgstr "Demasiados intentos fallidos, espere un momento"

#: src/pam.rs:146
msgid "Unknown user"
msgstr "Usuario desconocido"

#: src/pam.rs:147
msgid "The password must be changed (console)"
msgstr "Es necesario cambiar la contraseña (consola)"

#: src/pam.rs:148
msgid "The account has expired"
msgstr "La cuenta ha caducado"

#: src/pam.rs:149
msgid "Access denied"
msgstr "Acceso denegado"

#: src/pam.rs:152
#, no-c-format
msgid "PAM error {code}"
msgstr "Error de PAM {code}"

#: src/pam.rs:205
msgid "libpam.so.0 cannot be loaded"
msgstr "no se puede cargar libpam.so.0"

#: src/pam.rs:261
msgid "The input contains a null character"
msgstr "La entrada contiene un carácter nulo"

#: src/sperre.rs:331
msgid "Please enter your password"
msgstr "Introduzca la contraseña"

#: src/sperre.rs:360
msgid "Checking password…"
msgstr "Comprobando la contraseña…"

#: src/sperre.rs:381
#, no-c-format
msgid "Cannot check the password: {error}"
msgstr "No se pudo comprobar: {error}"

